{
	"name": "deck-roulette",
	"version": "1.3.5",
	"description": "A plugin that allows you to navigate to a random game in your library or a Steam Collection.",
	"type": "module",
	"packageManager": "pnpm@9.4.0",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"typecheck": "tsc --noEmit",
		"test": "pnpm run typecheck && pnpm run test:frontend && pnpm run test:backend",
		"test:frontend": "vitest run",
		"test:backend": "python3 -m unittest discover -s tests -p 'test_*.py'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisae9/deck-roulette.git"
	},
	"keywords": [
		"decky",
		"plugin",
		"steam-deck",
		"deck",
		"random",
		"games",
		"steam"
	],
	"author": "Jonas Dellinger <jonas@dellinger.dev>, Chris Alves <contact@chis.dev>",
	"license": "BSD-3-Clause",
	"bugs": {
		"url": "https://github.com/chrisae9/deck-roulette/issues"
	},
	"homepage": "https://github.com/chrisae9/deck-roulette#readme",
	"devDependencies": {
		"@decky/rollup": "^1.0.2",
		"@decky/ui": "^4.12.0",
		"@rollup/rollup-linux-x64-musl": "^4.53.3",
		"@types/react": "19.1.1",
		"@types/react-dom": "19.1.1",
		"@types/webpack": "^5.28.1",
		"rollup": "^4.53.3",
		"typescript": "^5.6.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@decky/api": "^1.1.3",
		"react-icons": "^5.3.0",
		"tslib": "^2.7.0"
	},
	"pnpm": {
		"peerDependencyRules": {
			"ignoreMissing": [
				"react",
				"react-dom"
			]
		}
	}
}
